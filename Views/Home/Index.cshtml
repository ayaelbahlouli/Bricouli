    <h2 class="section-title">Nos Catégories de Services</h2>
    <p class="section-subtitle">
        Plus de 50 catégories de services pour tous vos besoins
    </p>

    <div class="categories-scroll">
        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=500"
                 alt="Plomberie"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">🔧 Plomberie</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1513828583688-c52646db42da?w=500"
                 alt="Électricité"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">⚡ Électricité</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=500"
                 alt="Menuiserie"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">🪚 Menuiserie</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=500"
                 alt="Peinture"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">🎨 Peinture</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=500"
                 alt="Jardinage"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">🌱 Jardinage</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=500"
                 alt="Déménagement"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">📦 Déménagement</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=500"
                 alt="Événements"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">🎉 Événements</h3>
            </div>
        </div>

        <div class="category-card">
            <img src="https://images.unsplash.com/photo-1511367461989-f85a21fda167?w=500"
                 alt="Musique"
                 class="category-image">
            <div class="category-overlay">
                <h3 class="category-name">🎵 Musique</h3>
            </div>
        </div>
    </div>
</section>

<!-- STATISTIQUES SECTION -->
<section class="features-section" style="background: white;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <h2 class="section-title">Bricouli en Chiffres</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 60px; text-align: center; margin-top: 60px;">
            <div>
                <div class="counter" data-target="15000" style="font-size: 56px; font-weight: 800; color: #C1272D; margin-bottom: 12px;">0</div>
                <p style="font-size: 18px; color: #6b7280;">Professionnels Actifs</p>
            </div>
            <div>
                <div class="counter" data-target="50000" style="font-size: 56px; font-weight: 800; color: #006233; margin-bottom: 12px;">0</div>
                <p style="font-size: 18px; color: #6b7280;">Clients Satisfaits</p>
            </div>
            <div>
                <div class="counter" data-target="100000" style="font-size: 56px; font-weight: 800; color: #667eea; margin-bottom: 12px;">0</div>
                <p style="font-size: 18px; color: #6b7280;">Projets Réalisés</p>
            </div>
            <div>
                <div style="font-size: 56px; font-weight: 800; color: #f59e0b; margin-bottom: 12px;">4.8★</div>
                <p style="font-size: 18px; color: #6b7280;">Note Moyenne</p>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS SECTION -->
<section class="how-it-works-section" id="comment-ca-marche">
    <h2 class="section-title">Comment Ça Marche ?</h2>
    <p class="section-subtitle">Un processus simple en 4 étapes</p>

    <div class="steps-container">
        <div class="step">
            <div class="step-content">
                <div class="step-number">01</div>
                <h3 class="step-title">Décrivez Votre Besoin</h3>
                <p class="step-description">
                    Expliquez votre projet en quelques clics : type de service, lieu, budget, et délais souhaités.
                </p>
            </div>
            <div class="step-visual">
                📝
            </div>
        </div>

        <div class="step">
            <div class="step-content">
                <div class="step-number">02</div>
                <h3 class="step-title">Recevez Des Propositions</h3>
                <p class="step-description">
                    Les professionnels intéressés vous envoient leurs devis et disponibilités en quelques minutes.
                </p>
            </div>
            <div class="step-visual">
                💼
            </div>
        </div>

        <div class="step">
            <div class="step-content">
                <div class="step-number">03</div>
                <h3 class="step-title">Choisissez Votre Pro</h3>
                <p class="step-description">
                    Comparez les profils, consultez les avis, et sélectionnez le professionnel qui vous convient.
                </p>
            </div>
            <div class="step-visual">
                ✅
            </div>
        </div>

        <div class="step">
            <div class="step-content">
                <div class="step-number">04</div>
                <h3 class="step-title">Projet Terminé !</h3>
                <p class="step-description">
                    Le professionnel réalise votre projet. Vous payez et laissez un avis une fois satisfait.
                </p>
            </div>
            <div class="step-visual">
                🎉
            </div>
        </div>
    </div>
</section>

<!-- CTA SECTION -->
<section class="features-section" style="background: linear-gradient(135deg, #C1272D 0%, #006233 100%); color: white;" id="rejoindre">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <h2 class="section-title" style="color: white;">Prêt à Commencer ?</h2>
        <p class="section-subtitle" style="color: rgba(255,255,255,0.9);">
            Rejoignez des milliers d'utilisateurs qui font confiance à Bricouli
        </p>
        <div style="display: flex; gap: 20px; justify-content: center; margin-top: 40px; flex-wrap: wrap;">
            <a href="#" class="btn-primary" style="background: white; color: #C1272D;">
                Trouver un Professionnel
            </a>
            <a href="#" class="btn-secondary" style="border-color: white; color: white;">
                Devenir Prestataire
            </a>
        </div>
    </div>
</section>