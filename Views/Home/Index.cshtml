@{
    ViewData["Title"] = "Bricouli - Connectez-vous aux Meilleurs Artisans du Maroc";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-background"></div>
    <div class="hero-content">
        <h1 class="hero-title">Trouvez le Professionnel Parfait</h1>
        <p class="hero-subtitle">
            Connectez-vous avec des milliers d'artisans qualifiés partout au Maroc 🇲🇦
        </p>
        <div class="hero-buttons">
            <a href="#services" class="btn-primary">Trouver un Professionnel</a>
            <a href="#rejoindre" class="btn-secondary">Devenir Prestataire</a>
        </div>
    </div>
</section>

<!-- FEATURES SECTION -->
<section class="features-section" id="features">
    <h2 class="section-title">Pourquoi Choisir Bricouli ?</h2>
    <p class="section-subtitle">
        Une plateforme moderne qui simplifie la recherche de professionnels de confiance
    </p>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">🔍</div>
            <h3 class="feature-title">Recherche Facile</h3>
            <p class="feature-description">
                Trouvez rapidement le professionnel qu'il vous faut grâce à notre système de recherche intelligent et nos filtres avancés.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">⭐</div>
            <h3 class="feature-title">Professionnels Vérifiés</h3>
            <p class="feature-description">
                Tous nos prestataires sont vérifiés et notés par la communauté pour garantir la qualité de service.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">💬</div>
            <h3 class="feature-title">Communication Directe</h3>
            <p class="feature-description">
                Discutez directement avec les professionnels, négociez les tarifs et planifiez vos interventions.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🛡️</div>
            <h3 class="feature-title">Paiement Sécurisé</h3>
            <p class="feature-description">
                Transactions sécurisées avec plusieurs moyens de paiement et protection contre les fraudes.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3 class="feature-title">Application Mobile</h3>
            <p class="feature-description">
                Accédez à Bricouli depuis votre smartphone, où que vous soyez au Maroc.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🚀</div>
            <h3 class="feature-title">Service Rapide</h3>
            <p class="feature-description">
                Recevez des propositions en quelques minutes et trouvez le professionnel disponible rapidement.
            </p>
        </div>
    </div>
</section>

