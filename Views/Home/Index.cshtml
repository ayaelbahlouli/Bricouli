<!-- STATS SECTION -->
<section class="stats-section">
 <div class="container">
 <div class="section-intro">
 <h2 class="section-title">Bricouli en chiffres</h2>
 <p class="section-subtitle">Des resultats concrets pour les particuliers et les pros.</p>
 </div>
 <div class="stat-grid">
 <div class="stat-card">
 <div class="stat-value counter" data-target="15000" style="color: #C1272D;">0</div>
 <div class="stat-label">Professionnels actifs</div>
 </div>
 <div class="stat-card">
 <div class="stat-value counter" data-target="50000" style="color: #006233;">0</div>
 <div class="stat-label">Clients satisfaits</div>
 </div>
 <div class="stat-card">
 <div class="stat-value counter" data-target="100000" style="color: #7c83ff;">0</div>
 <div class="stat-label">Projets realises</div>
 </div>
 <div class="stat-card">
 <div class="stat-value" style="color: #f59e0b;">4.8&#9733;</div>
 <div class="stat-label">Note moyenne</div>
 </div>
 </div>
 </div>
</section>

<!-- HOW IT WORKS SECTION -->
<section class="how-it-works-section" id="comment-ca-marche">
 <div class="section-intro">
 <h2 class="section-title">Comment ca marche ?</h2>
 <p class="section-subtitle">Un processus simple en 4 etapes.</p>
 </div>

 <div class="steps-container">
 <div class="step">
 <div class="step-content">
 <div class="step-number">01</div>
 <h3 class="step-title">Decrivez votre besoin</h3>
 <p class="step-description">
 Expliquez votre projet : type de service, lieu, budget et delais souhaites.
 </p>
 </div>
 <div class="step-visual">&#128221;</div>
 </div>

 <div class="step">
 <div class="step-content">
 <div class="step-number">02</div>
 <h3 class="step-title">Recevez des propositions</h3>
 <p class="step-description">
 Les professionnels interesses vous envoient leurs devis et disponibilites rapidement.
 </p>
 </div>
 <div class="step-visual">&#128172;</div>
 </div>

 <div class="step">
 <div class="step-content">
 <div class="step-number">03</div>
 <h3 class="step-title">Choisissez votre pro</h3>
 <p class="step-description">
 Comparez les profils, consultez les avis et selectionnez le meilleur candidat.
 </p>
 </div>
 <div class="step-visual">&#128100;</div>
 </div>

 <div class="step">
 <div class="step-content">
 <div class="step-number">04</div>
 <h3 class="step-title">Projet termine</h3>
 <p class="step-description">
 Le professionnel realise votre projet. Vous payez et laissez un avis.
 </p>
 </div>
 <div class="step-visual">&#9989;</div>
 </div>
 </div>
</section>

<!-- CTA SECTION -->
<section class="cta-section" id="rejoindre">
 <div style="max-width:800px; margin:0 auto; text-align: center;">
 <h2 class="section-title">Pret a commencer ?</h2>
 <p class="section-subtitle">
 Rejoignez des milliers d'utilisateurs qui font confiance a Bricouli.
 </p>
 <div style="display: flex; gap:20px; justify-content: center; margin-top:40px; flex-wrap: wrap;">
 <a href="/Devis" class="btn-primary" role="button" aria-label="Demander un devis">
 Demander un devis
 </a>
 <a href="/Contact" class="btn-secondary" role="button" aria-label="Nous contacter">
 Nous contacter
 </a>
 </div>
 </div>
</section>
