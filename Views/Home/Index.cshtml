@{
 ViewData["Title"] = "Bricouli - Connectez-vous aux meilleurs artisans du Maroc";
}

<!-- HERO SECTION -->
<section id="home" class="hero-section">
 <div class="hero-background"></div>
 <div class="hero-content">
 <div class="hero-kicker">Plateforme marocaine</div>
 <h1 class="hero-title">Trouvez le professionnel parfait</h1>
 <p class="hero-subtitle">
 Connectez-vous avec des milliers d'artisans qualifies partout au Maroc.
 </p>
 <div class="hero-buttons">
 <a href="/FindProfessional" class="btn-primary" role="button" aria-label="Trouver un professionnel">Trouver un professionnel</a>
 <a href="/BecomeProvider" class="btn-secondary" role="button" aria-label="Devenir prestataire">Devenir prestataire</a>
 <a href="/Contact" class="btn-secondary" role="button" aria-label="Contactez-nous">Contact</a>
 </div>
 <div class="hero-badges">
 <span class="pill">+50 categories</span>
 <span class="pill">Profils verifies</span>
 <span class="pill">Support rapide</span>
 </div>
 </div>
</section>

<!-- FEATURES SECTION -->
<section class="features-section" id="features">
 <div class="section-intro">
 <h2 class="section-title">Pourquoi choisir Bricouli ?</h2>
 <p class="section-subtitle">
 Une plateforme moderne qui simplifie la recherche de professionnels de confiance.
 </p>
 </div>

 <div class="features-grid">
 <div class="feature-card" data-action="find" role="button" tabindex="0">
 <div class="feature-icon">&#128269;</div>
 <h3 class="feature-title">Recherche facile</h3>
 <p class="feature-description">
 Trouvez rapidement le professionnel qu'il vous faut grace a un moteur intelligent et des filtres avances.
 </p>
 </div>

 <div class="feature-card" data-action="find" role="button" tabindex="0">
 <div class="feature-icon">&#9989;</div>
 <h3 class="feature-title">Professionnels verifies</h3>
 <p class="feature-description">
 Des profils controles et notes par la communaute pour garantir la qualite de service.
 </p>
 </div>

 <div class="feature-card" data-action="find" role="button" tabindex="0">
 <div class="feature-icon">&#128172;</div>
 <h3 class="feature-title">Communication directe</h3>
 <p class="feature-description">
 Discutez avec les professionnels, negociez les tarifs et planifiez vos interventions.
 </p>
 </div>

 <div class="feature-card" data-action="find" role="button" tabindex="0">
 <div class="feature-icon">&#128179;</div>
 <h3 class="feature-title">Paiement securise</h3>
 <p class="feature-description">
 Transactions protegees avec plusieurs moyens de paiement et protection contre les fraudes.
 </p>
 </div>

 <div class="feature-card" data-action="find" role="button" tabindex="0">
 <div class="feature-icon">&#128241;</div>
 <h3 class="feature-title">Application mobile</h3>
 <p class="feature-description">
 Accedez a Bricouli depuis votre smartphone, ou que vous soyez au Maroc.
 </p>
 </div>

 <div class="feature-card" data-action="find" role="button" tabindex="0">
 <div class="feature-icon">&#9889;</div>
 <h3 class="feature-title">Service rapide</h3>
 <p class="feature-description">
 Recevez des propositions en quelques minutes et trouvez le professionnel disponible rapidement.
 </p>
 </div>
 </div>
</section>

