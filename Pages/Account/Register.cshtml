@page
@model Bricouli.Pages.Account.RegisterModel
@{
 Layout = "~/Views/Shared/_Layout.cshtml";
 ViewData["Title"] = "Inscription";
}

<section class="auth-section">
 <div class="auth-container">
 <h2 class="section-title">Creer un compte</h2>
 <p class="section-subtitle">Inscrivez-vous pour recevoir des demandes et gerer votre profil.</p>

 <div class="form-card auth-card">
 <div class="form-body">
 <form method="post" class="contact-form">
 @Html.AntiForgeryToken()
 <div class="form-group">
 <label for="regName">Nom complet</label>
 <input id="regName" name="Name" class="form-input" required />
 </div>
 <div class="form-group">
 <label for="regEmail">Email</label>
 <input id="regEmail" name="Email" type="email" class="form-input" required />
 </div>
 <div class="form-group">
 <label for="regPassword">Mot de passe</label>
 <input id="regPassword" name="Password" type="password" class="form-input" required />
 </div>
 <div class="form-actions">
 <button class="btn-primary" type="submit">S'inscrire</button>
 <a href="/" class="btn-secondary">Annuler</a>
 </div>
 </form>
 </div>
 </div>
 </div>
</section>
