@page
@model dynamic
@{
 Layout = "~/Views/Shared/_Layout.cshtml";
 ViewData["Title"] = "Contact";
}

<section class="features-section page-section contact-section" style="padding-top:80px;">
 <div class="container">
 <div class="page-hero">
 <span class="eyebrow">Contact</span>
 <h2 class="section-title">Contactez-nous</h2>
 <p class="section-subtitle">Envoyez-nous un message et nous vous répondrons rapidement.</p>
 </div>

 <div class="info-grid">
 <div class="info-card">
 <div class="icon-badge">&#9201;</div>
 <h4>Réponse rapide</h4>
 <p>Notre équipe vous répond sous 24-48h ouvrables.</p>
 </div>
 <div class="info-card">
 <div class="icon-badge">&#128274;</div>
 <h4>Données protégées</h4>
 <p>Vos informations restent confidentielles et sécurisées.</p>
 </div>
 <div class="info-card">
 <div class="icon-badge">&#128222;</div>
 <h4>Support humain</h4>
 <p>Une équipe locale pour vous accompagner efficacement.</p>
 </div>
 </div>

 <div class="contact-layout">
 <div class="form-card">
 <div class="form-header">
 <h3>Envoyer un message</h3>
 <p class="section-muted">Nous répondons généralement sous 24-48h ouvrées.</p>
 </div>
 <div class="form-body">
 <form method="post" action="/Contact" class="contact-form">
 <div class="form-grid">
 <div class="form-group">
 <label for="contactName">Nom complet <span class="required">*</span></label>
 <input id="contactName" name="Name" placeholder="Votre nom" class="form-input" required />
 </div>
 <div class="form-group">
 <label for="contactEmail">Email <span class="required">*</span></label>
 <input id="contactEmail" name="Email" type="email" placeholder="Votre email" class="form-input" required />
 </div>
 </div>
 <div class="form-group">
 <label for="contactMessage">Message <span class="required">*</span></label>
 <textarea id="contactMessage" name="Message" placeholder="Votre message" class="form-textarea" required></textarea>
 </div>
 <div class="form-actions">
 <button class="btn-primary">Envoyer</button>
 <a class="btn-secondary" href="/">Annuler</a>
 </div>
 </form>
 </div>
 </div>

 <aside class="contact-aside">
 <h4>Besoin d'un devis rapidement ?</h4>
 <p>Décrivez votre besoin et recevez des propositions de professionnels près de chez vous.</p>
 <a class="btn-secondary" href="/FindProfessional">Demander un devis</a>
 <div style="margin-top:18px;">
 <span class="pill">Réponse rapide</span>
 <span class="pill">Données sécurisées</span>
 <span class="pill">Assistance dédiée</span>
 </div>
 </aside>
 </div>
 </div>
</section>
