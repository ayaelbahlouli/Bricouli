<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Bricouli</title>
    <link rel="stylesheet" href="~/css/bricouli-style.css" asp-append-version="true" />
</head>
<body class="admin-ui">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-brand">Bricouli Admin</div>
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-area="Admin" asp-controller="DevisRequests" asp-action="Index">Devis</a>
                <a asp-area="Admin" asp-controller="ProviderApplications" asp-action="Index">Prestataires</a>
                <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">Messages</a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">Utilisateurs</a>
                <a href="/">Retour site</a>
            </nav>
        </aside>
        <main class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-title">@ViewData["Title"]</div>
                    <div class="admin-subtitle">Gestion et suivi des demandes</div>
                </div>
                <div class="admin-actions">
                    <a class="btn-secondary" href="/Account/Logout">Deconnexion</a>
                </div>
            </header>
            <section class="admin-body">
                @RenderBody()
            </section>
        </main>
    </div>
</body>
</html>
