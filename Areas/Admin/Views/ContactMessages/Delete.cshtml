@model Bricouli.Models.ContactMessage
@{
    ViewData["Title"] = "Supprimer un message";
}

<div class="admin-form-card admin-fade">
    <h3>Confirmer la suppression</h3>
    <p>Voulez-vous supprimer le message de <strong>@Model.Name</strong> ?</p>
    <form asp-area="Admin" asp-controller="ContactMessages" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button class="btn-primary" type="submit">Supprimer</button>
            <a class="btn-secondary" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
