@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Supprimer utilisateur";
}

<div class="admin-form-card admin-fade">
    <h3>Confirmer la suppression</h3>
    <p>Voulez-vous supprimer le compte <strong>@Model.Email</strong> ?</p>
    <form asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <button class="btn-primary" type="submit">Supprimer</button>
            <a class="btn-secondary" asp-area="Admin" asp-controller="Users" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
