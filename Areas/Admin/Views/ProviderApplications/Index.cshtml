@model IEnumerable<Bricouli.Models.ProviderApplication>
@{
    ViewData["Title"] = "Prestataires";
}

<div class="admin-toolbar">
    <a class="btn-primary" asp-area="Admin" asp-controller="ProviderApplications" asp-action="Create">Ajouter</a>
</div>

<div class="admin-table-wrap admin-fade">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Telephone</th>
                <th>Categorie</th>
                <th>Statut</th>
                <th>Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" style="text-align:center; padding: 24px; color: var(--gray-700);">
                    Aucun prestataire pour le moment. Les demandes ajoutees depuis la page
                    <a href="/BecomeProvider" style="color: var(--gray-900); text-decoration: underline;">Devenir Prestataire</a>
                    apparaitront ici.
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Category</td>
                    <td><span class="admin-pill status-@item.Status">@item.Status</span></td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="admin-actions-cell">
                        <a asp-area="Admin" asp-controller="ProviderApplications" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>
                        <a asp-area="Admin" asp-controller="ProviderApplications" asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
