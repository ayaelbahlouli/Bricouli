@model Bricouli.Models.ProviderApplication
@{
    ViewData["Title"] = "Modifier un prestataire";
}

<div class="admin-form-card admin-fade">
    <form asp-area="Admin" asp-controller="ProviderApplications" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name">Nom</label>
                <input asp-for="Name" class="form-input" />
            </div>
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-input" />
            </div>
            <div class="form-group">
                <label asp-for="Phone">Telephone</label>
                <input asp-for="Phone" class="form-input" />
            </div>
            <div class="form-group">
                <label asp-for="Category">Categorie</label>
                <input asp-for="Category" class="form-input" />
            </div>
            <div class="form-group">
                <label asp-for="Status">Statut</label>
                <select asp-for="Status" class="form-input">
                    <option value="new">Nouveau</option>
                    <option value="approved">Approuve</option>
                    <option value="rejected">Refuse</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-textarea" rows="5"></textarea>
        </div>
        <div class="form-actions">
            <button class="btn-primary" type="submit">Mettre a jour</button>
            <a class="btn-secondary" asp-area="Admin" asp-controller="ProviderApplications" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
